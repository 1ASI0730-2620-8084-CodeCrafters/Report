@startuml
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #ffffff
  BorderColor #b34900
  ArrowColor #4f2000
}
skinparam package {
  BackgroundColor #fff7ed
  BorderColor #f97316
}
left to right direction

package "Identity and Access Management" {
  class Organization <<Aggregate Root>> {
    - id: Guid
    - businessName: string
    - taxId: TaxId
    - email: EmailAddress
    - phone: string
    - address: string
    + Register(businessName, taxId, email): Organization
    + UpdateProfile(businessName, phone, address): void
  }
  class User <<Aggregate Root>> {
    - id: Guid
    - organizationId: Guid
    - firstName: string
    - lastName: string
    - email: EmailAddress
    - passwordHash: string
    - role: UserRole
    - status: UserStatus
    + Register(organizationId, firstName, lastName, email, role): User
    + AssignRole(role: UserRole): void
    + Deactivate(): void
  }
  class EmailAddress <<Value Object>> {
    - value: string
  }
  class TaxId <<Value Object>> {
    - value: string
  }
  enum UserRole {
    Administrator
    FleetSupervisor
    DeliveryPointOwner
  }
  enum UserStatus {
    Active
    Inactive
  }
  Organization "1" -- "1..*" User
  User --> UserRole
  User --> UserStatus
  User *-- EmailAddress
  Organization *-- TaxId
}

package "Fleet Management" {
  class Vehicle <<Aggregate Root>> {
    - id: Guid
    - organizationId: Guid
    - plateNumber: PlateNumber
    - brand: string
    - model: string
    - capacityInBoxes: int
    - status: VehicleStatus
    + Register(organizationId, plateNumber, brand, model, capacityInBoxes): Vehicle
    + Reserve(): void
    + Release(): void
    + SendToMaintenance(): void
  }
  class Driver <<Aggregate Root>> {
    - id: Guid
    - organizationId: Guid
    - firstName: string
    - lastName: string
    - documentNumber: string
    - licenseNumber: LicenseNumber
    - phone: string
    - status: DriverStatus
    + Register(organizationId, firstName, lastName, licenseNumber): Driver
    + Reserve(): void
    + Release(): void
  }
  class PlateNumber <<Value Object>> {
    - value: string
  }
  class LicenseNumber <<Value Object>> {
    - value: string
  }
  enum VehicleStatus {
    Available
    Assigned
    InMaintenance
  }
  enum DriverStatus {
    Available
    Assigned
    Inactive
  }
  Vehicle *-- PlateNumber
  Vehicle --> VehicleStatus
  Driver *-- LicenseNumber
  Driver --> DriverStatus
}

package "Operations and Routes" {
  class TransportOperation <<Aggregate Root>> {
    - id: Guid
    - code: string
    - organizationId: Guid
    - description: string
    - scheduledDate: DateOnly
    - vehicleId: Guid
    - driverId: Guid
    - status: OperationStatus
    - dispatchedAt: DateTime
    - completedAt: DateTime
    + Create(organizationId, description, scheduledDate): TransportOperation
    + AssignResources(vehicleId, driverId): void
    + AddDeliveryStop(deliveryPointId, plannedQuantity): void
    + ReorderStops(stopIds: List<Guid>): void
    + Dispatch(): void
    + Start(): void
    + RecordDelivery(stopId, deliveredQuantity, reason): void
    + Complete(): void
    + Cancel(reason): void
    + CalculateProgress(): decimal
  }
  class DeliveryStop <<Entity>> {
    - id: Guid
    - deliveryPointId: Guid
    - sequenceNumber: int
    - plannedQuantity: Quantity
    - deliveredQuantity: Quantity
    - status: DeliveryStatus
    - failureReason: string
    - confirmedAt: DateTime
    + MarkAsDelivered(quantity): void
    + MarkAsPartiallyDelivered(quantity, reason): void
    + MarkAsNotDelivered(reason): void
    + CalculateShortage(): int
  }
  class DeliveryPoint <<Aggregate Root>> {
    - id: Guid
    - organizationId: Guid
    - ownerUserId: Guid
    - businessName: string
    - address: string
    - district: string
    - latitude: decimal
    - longitude: decimal
    + Register(organizationId, businessName, address): DeliveryPoint
    + UpdateLocation(latitude, longitude): void
  }
  class Quantity <<Value Object>> {
    - boxes: int
  }
  enum OperationStatus {
    Pending
    Dispatched
    InProgress
    Completed
    Cancelled
  }
  enum DeliveryStatus {
    Pending
    Delivered
    PartiallyDelivered
    NotDelivered
  }
  TransportOperation "1" *-- "1..*" DeliveryStop
  TransportOperation --> OperationStatus
  DeliveryStop --> DeliveryStatus
  DeliveryStop *-- Quantity
  DeliveryStop "0..*" --> "1" DeliveryPoint
}

package "IoT Monitoring" {
  class IoTDevice <<Aggregate Root>> {
    - id: Guid
    - serialNumber: string
    - vehicleId: Guid
    - safeRange: SafeRange
    - impactThreshold: decimal
    - status: DeviceStatus
    + InstallOnVehicle(vehicleId): void
    + ConfigureSafeRange(minimum, maximum): void
    + Evaluate(reading: SensorReading): Alert
  }
  class SensorReading <<Entity>> {
    - id: Guid
    - deviceId: Guid
    - transportOperationId: Guid
    - recordedAt: DateTime
    - latitude: decimal
    - longitude: decimal
    - temperatureCelsius: decimal
    - impactForce: decimal
  }
  class Alert <<Aggregate Root>> {
    - id: Guid
    - deviceId: Guid
    - transportOperationId: Guid
    - type: AlertType
    - raisedAt: DateTime
    - acknowledgedAt: DateTime
    + Acknowledge(userId): void
  }
  class SafeRange <<Value Object>> {
    - minimumCelsius: decimal
    - maximumCelsius: decimal
    + Contains(value): bool
  }
  enum AlertType {
    TemperatureOutOfRange
    ImpactDetected
    DeviceOffline
  }
  enum DeviceStatus {
    Active
    Offline
    Retired
  }
  IoTDevice *-- SafeRange
  IoTDevice "1" --> "0..*" SensorReading
  IoTDevice ..> Alert : raises
  Alert --> AlertType
  IoTDevice --> DeviceStatus
}

package "Incident Management" {
  class Incident <<Aggregate Root>> {
    - id: Guid
    - code: string
    - transportOperationId: Guid
    - deliveryStopId: Guid
    - reportedBy: Guid
    - source: IncidentSource
    - type: IncidentType
    - severity: Severity
    - description: string
    - affectedQuantity: int
    - status: IncidentStatus
    - resolution: string
    + Report(operationId, type, description, source): Incident
    + AttachEvidence(fileUrl, fileType): void
    + AssignSeverity(severity): void
    + Review(): void
    + Resolve(resolution): void
    + Close(): void
  }
  class Evidence <<Entity>> {
    - id: Guid
    - fileUrl: string
    - fileType: string
    - uploadedAt: DateTime
  }
  enum IncidentType {
    BrokenBottles
    DamagedProduct
    Shortage
    Delay
  }
  enum Severity {
    Low
    Medium
    High
    Critical
  }
  enum IncidentStatus {
    Reported
    UnderReview
    Resolved
    Closed
  }
  enum IncidentSource {
    FleetSupervisor
    DeliveryPoint
    IoTAlert
  }
  Incident "1" *-- "0..*" Evidence
  Incident --> IncidentType
  Incident --> Severity
  Incident --> IncidentStatus
  Incident --> IncidentSource
}

TransportOperation ..> Vehicle : vehicleId
TransportOperation ..> Driver : driverId
Incident ..> TransportOperation : transportOperationId
Alert ..> TransportOperation : transportOperationId
@enduml
